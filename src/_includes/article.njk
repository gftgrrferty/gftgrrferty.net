{% extends "base.njk" %}

{% block content %}
<article>
  <h1 itemprop="headline">{{ title }}</h1>
  
  <time datetime="{{ date | dateISO }}">
    {{ date | date }}
  </time>

  {% if update %}
  <br>
  <time datetime="{{ update | dateISO }}">
    更新: {{ update | date }}
  </time>
  {% endif %}

  {{ content | safe }}
</article>
{% endblock %}
