---
permalink: "/feed-embed/"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>最新のノート</title>
<link rel="stylesheet" href="/feed-embed.css">
</head>
<body>
<div class="notes-panel">
  {% for note in collections.notes | firstItems(5) %}
  <a class="note-row" href="{{ note.url }}" target="_top">
    <span class="note-date">{{ note.data.date | dateISO | replace("-", ".") | replace("-", ".") }}</span>
    <span class="note-title">{{ note.data.title | escape }}</span>
    <span class="note-arrow">→</span>
  </a>
  {% endfor %}
  <a class="notes-more" href="/feed/" target="_top">すべてのノートを見る →</a>
</div>
</body>
</html>
