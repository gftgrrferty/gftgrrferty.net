---
permalink: "/feed-embed/"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>最新のノート</title>
<style>
  body {
    margin: 0;
    padding: 6px;
    font-family: system-ui, sans-serif;
  }
  .notes-panel {
    background-color: white;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 20px;
    box-shadow: 0px 2px 16px rgb(0 0 0 / 0.06);
    padding: 10px 28px;
  }
  .note-row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
    text-decoration: none;
    color: #000;
  }
  .note-date {
    color: #999;
    font-size: 14px;
    width: 90px;
    flex-shrink: 0;
  }
  .note-title {
    font-weight: bold;
  }
  .note-arrow {
    margin-left: auto;
    color: #999;
  }
  .notes-more {
    display: block;
    text-align: center;
    color: #d97b9f;
    font-weight: bold;
    text-decoration: none;
    padding: 16px 0 10px;
  }
</style>
</head>
<body>
<div class="notes-panel">
  {% for note in collections.notes | firstItems(5) %}
  <a class="note-row" href="{{ note.url }}" target="_top">
    <span class="note-date">{{ note.data.date | dateISO | replace("-", ".") | replace("-", ".") }}</span>
    <span class="note-title">{{ note.data.title | escape }}</span>
    <span class="note-arrow">→</span>
  </a>
  {% endfor %}
  <a class="notes-more" href="/feed/" target="_top">すべてのノートを見る →</a>
</div>
</body>
</html>
