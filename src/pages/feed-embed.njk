---
permalink: "/feed-embed/"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>最新のノート</title>
<link rel="stylesheet" href="/feed-embed.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;500;700;800&display=swap" rel="stylesheet">
</head>
<body>
<div class="notes-panel">
  {% for note in collections.notes | firstItems(5) %}
  <a class="note-row" href="{{ note.url }}" target="_top">
    <span class="note-date">{{ note.data.date | dateISO | replace("-", ".") | replace("-", ".") }}</span>
    <span class="note-title">{{ note.data.title | escape }}</span>
    <span class="note-arrow">→</span>
  </a>
  {% endfor %}
  <a class="notes-more" href="/feed/" target="_top">すべてのノートを見る →</a>
</div>
</body>
</html>
